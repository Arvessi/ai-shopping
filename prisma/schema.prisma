generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wishlists    Wishlist[]
  alerts       PriceAlert[]
  searches     SearchLog[]
  pushSubs     PushSubscription[]
}

model Product {
  id               String   @id @default(cuid())
  externalId       String   @unique
  sourceProductId  String?
  gid              String?
  dataDocId        String?
  title            String
  normalizedTitle  String
  brand            String?
  category         String?
  description      String?
  image            String?
  currency         String   @default("EUR")
  currentBestPrice Float?
  dealScore        Int      @default(50)
  source           String   @default("dataforseo")
  lastSyncedAt     DateTime @default(now())
  lastEnrichedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  offers           Offer[]
  snapshots        PriceSnapshot[]
  wishlistedBy     Wishlist[]
  alerts           PriceAlert[]

  @@index([source, normalizedTitle])
}

model Offer {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant        String
  merchantDomain  String?
  variantLabel    String?
  variantData     Json?
  image            String?
  price           Float
  shipping        Float    @default(0)
  shippingKnown   Boolean  @default(false)
  totalPrice      Float
  currency        String   @default("EUR")
  sellerRating    Float?
  sellerVotes     Int?
  deliveryMessage String?
  rawUrl          String?
  dealScore       Int      @default(50)
  isCheapest      Boolean  @default(false)
  isBestOverall   Boolean  @default(false)
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clicks          AffiliateClick[]

  @@index([productId, totalPrice])
  @@index([productId, merchant])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  currency   String   @default("EUR")
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  familyId  String?
  variantId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  family    ProductFamily? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, familyId, variantId])
}

model PriceAlert {
  id              String   @id @default(cuid())
  userId          String
  productId       String?
  familyId        String?
  variantId       String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  family          ProductFamily? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  targetPrice     Float
  emailEnabled    Boolean  @default(true)
  browserEnabled  Boolean  @default(true)
  active          Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, productId])
  @@index([active, variantId])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  mode      String   @default("search")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateClick {
  id        String   @id @default(cuid())
  offerId   String?
  merchantOfferId String?
  offer     Offer?    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  merchantOffer MerchantOffer? @relation(fields: [merchantOfferId], references: [id], onDelete: Cascade)
  subId     String
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
  @@index([merchantOfferId, createdAt])
}

model SearchCache {
  id        String   @id @default(cuid())
  key       String   @unique
  query     String
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Merchant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domain      String?
  active      Boolean  @default(true)
  trustScore  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  feeds       FeedSource[]
  offers       CatalogOffer[]
  crawlSources CrawlSource[]
  merchantOffers MerchantOffer[]

  @@index([active])
}

model FeedSource {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  slug           String   @unique
  name           String
  url            String
  format         String
  mapping        Json
  authHeaderEnv  String?
  active         Boolean  @default(true)
  lastImportedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  offers         CatalogOffer[]
  runs           ImportRun[]
  crawler        CrawlSource?

  @@index([merchantId, active])
}

model CatalogFamily {
  id              String   @id @default(cuid())
  canonicalKey    String   @unique
  title           String
  normalizedTitle String
  brand           String?
  model           String?
  category        String?
  image           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  variants        CatalogVariant[]

  @@index([normalizedTitle])
  @@index([brand, model])
}

model CatalogVariant {
  id           String        @id @default(cuid())
  familyId     String
  family       CatalogFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variantKey   String
  gtin         String?
  mpn          String?
  color        String?
  storage      String?
  ram          String?
  connectivity String?
  size         String?
  condition    String         @default("New")
  attributes   Json?
  image        String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  offers       CatalogOffer[]

  @@unique([familyId, variantKey])
  @@index([gtin])
  @@index([mpn])
}

model CatalogOffer {
  id              String         @id @default(cuid())
  offerKey        String         @unique
  sourceId        String
  source          FeedSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variantId       String
  variant         CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  externalId      String?
  title           String
  url             String
  image           String?
  price           Float
  oldPrice        Float?
  currency        String         @default("EUR")
  shippingPrice   Float?
  deliveryDaysMin Int?
  deliveryDaysMax Int?
  availability    String?
  stockQty        Int?
  condition       String         @default("New")
  active          Boolean        @default(true)
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  snapshots       CatalogPriceSnapshot[]

  @@index([variantId, active, price])
  @@index([merchantId, active])
  @@index([sourceId, active])
}

model CatalogPriceSnapshot {
  id            String       @id @default(cuid())
  offerId       String
  offer         CatalogOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  price         Float
  shippingPrice Float?
  availability  String?
  stockQty      Int?
  recordedAt    DateTime     @default(now())

  @@index([offerId, recordedAt])
}

model ImportRun {
  id            String     @id @default(cuid())
  sourceId      String
  source        FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status        String     @default("running")
  itemCount     Int        @default(0)
  acceptedCount Int        @default(0)
  rejectedCount Int        @default(0)
  error         String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  @@index([sourceId, startedAt])
}


model CrawlSource {
  id               String      @id @default(cuid())
  slug             String      @unique
  merchantId       String
  merchant         Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  feedSourceId     String      @unique
  feedSource       FeedSource  @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)
  origin           String
  active           Boolean     @default(true)
  priority         Int         @default(50)
  crawlDelayMs     Int         @default(1000)
  robotsAllowed    Boolean?
  robotsCheckedAt  DateTime?
  lastSeededAt     DateTime?
  lastRunAt        DateTime?
  lastError        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  pages            CrawlPage[]

  @@index([active, priority])
  @@index([lastSeededAt])
  @@index([lastRunAt])
}

model CrawlPage {
  id             String      @id @default(cuid())
  sourceId       String
  source         CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url            String
  urlHash        String
  kind           String      @default("candidate")
  status         String      @default("pending")
  priority       Int         @default(0)
  depth          Int         @default(0)
  attempts       Int         @default(0)
  lastHttpStatus Int?
  lastError      String?
  lastCrawledAt  DateTime?
  nextCrawlAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([sourceId, urlHash])
  @@index([sourceId, status, priority])
  @@index([status, nextCrawlAt])
}

enum ProductStatus {
  ACTIVE
  QUARANTINED
  ARCHIVED
}

enum IdentifierType {
  GTIN
  EAN
  UPC
  MPN
  SKU_ALIAS
  MODEL_ALIAS
}

enum PriceKind {
  ONE_TIME
  MONTHLY
  DEPOSIT
  PLAN
  UNKNOWN
}

enum ValidationStatus {
  ACCEPTED
  QUARANTINED
  REJECTED
}

enum EnrichmentStatus {
  queued
  running
  succeeded
  failed
  timed_out
}

model ProductFamily {
  id              String        @id @default(cuid())
  canonicalKey    String        @unique
  canonicalTitle  String
  normalizedTitle String
  brand           String?
  model           String?
  category        String?
  familyImageUrl  String?
  familyImageSource String?
  familyImageConfidence Float?
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  variants        ProductVariant[]
  aliases         ProductAlias[]
  wishlists       Wishlist[]
  alerts          PriceAlert[]

  @@index([normalizedTitle])
  @@index([brand, model])
}

model ProductVariant {
  id           String        @id @default(cuid())
  familyId     String
  family       ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variantKey   String
  attributes   Json
  storage      String?
  ram          String?
  color        String?
  connectivity String?
  cpu          String?
  gpu          String?
  size         String?
  resolution   String?
  panelType    String?
  refreshRate  String?
  kit          String?
  condition    String        @default("New")
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  identifiers  VariantIdentifier[]
  images       VariantImage[]
  offers       MerchantOffer[]
  aliases      ProductAlias[]
  wishlists    Wishlist[]
  alerts       PriceAlert[]

  @@unique([familyId, variantKey])
  @@index([familyId, status])
}

model VariantIdentifier {
  id              String         @id @default(cuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type            IdentifierType
  value           String
  normalizedValue String
  source          String
  confidence      Float          @default(1)
  createdAt       DateTime       @default(now())

  @@unique([type, normalizedValue, source])
  @@index([type, normalizedValue])
  @@index([variantId])
}

model VariantImage {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url            String
  source         String
  provenance     String
  confidence     Float          @default(0.5)
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([variantId, url])
  @@index([variantId, confidence])
}

model MerchantOffer {
  id               String           @id @default(cuid())
  variantId        String
  variant          ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  merchantId       String
  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sourceType       String
  sourceKey        String
  url              String
  imageUrl         String?
  oneTimePrice     Float?
  shippingPrice    Float?
  totalPrice       Float?
  currency         String           @default("EUR")
  priceKind        PriceKind        @default(UNKNOWN)
  availability     String?
  stockQty         Int?
  validationStatus ValidationStatus @default(QUARANTINED)
  rejectionReason  String?
  confidence       Float            @default(0.5)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  observations     OfferObservation[]
  clicks           AffiliateClick[]

  @@unique([merchantId, sourceKey])
  @@index([variantId, validationStatus, priceKind, totalPrice])
  @@index([lastSeenAt, expiresAt])
}

model OfferObservation {
  id            String        @id @default(cuid())
  offerId       String
  offer         MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  oneTimePrice  Float?
  shippingPrice Float?
  totalPrice    Float?
  priceKind     PriceKind
  availability  String?
  observedAt    DateTime      @default(now())

  @@index([offerId, observedAt])
}

model ProductAlias {
  id        String          @id @default(cuid())
  alias     String          @unique
  familyId  String
  family    ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now())
}

model EnrichmentJob {
  id              String           @id @default(cuid())
  normalizedQuery String
  familyId        String?
  status          EnrichmentStatus @default(queued)
  attempts        Int              @default(0)
  providerStage   String?
  providerTaskId  String?
  providerTaskIds Json?
  startedAt       DateTime?
  deadlineAt      DateTime
  finishedAt      DateTime?
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([normalizedQuery, status])
  @@index([status, deadlineAt])
}
