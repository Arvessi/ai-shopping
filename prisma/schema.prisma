generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wishlists    Wishlist[]
  alerts       PriceAlert[]
  searches     SearchLog[]
  pushSubs     PushSubscription[]
}

model Product {
  id               String   @id @default(cuid())
  externalId       String   @unique
  sourceProductId  String?
  gid              String?
  dataDocId        String?
  title            String
  normalizedTitle  String
  brand            String?
  category         String?
  description      String?
  image            String?
  currency         String   @default("EUR")
  currentBestPrice Float?
  dealScore        Int      @default(50)
  source           String   @default("dataforseo")
  lastSyncedAt     DateTime @default(now())
  lastEnrichedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  offers           Offer[]
  snapshots        PriceSnapshot[]
  wishlistedBy     Wishlist[]
  alerts           PriceAlert[]

  @@index([source, normalizedTitle])
}

model Offer {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant        String
  merchantDomain  String?
  variantLabel    String?
  variantData     Json?
  image            String?
  price           Float
  shipping        Float    @default(0)
  shippingKnown   Boolean  @default(false)
  totalPrice      Float
  currency        String   @default("EUR")
  sellerRating    Float?
  sellerVotes     Int?
  deliveryMessage String?
  rawUrl          String?
  dealScore       Int      @default(50)
  isCheapest      Boolean  @default(false)
  isBestOverall   Boolean  @default(false)
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clicks          AffiliateClick[]

  @@index([productId, totalPrice])
  @@index([productId, merchant])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  currency   String   @default("EUR")
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PriceAlert {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice     Float
  emailEnabled    Boolean  @default(true)
  browserEnabled  Boolean  @default(true)
  active          Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, productId])
}

model SearchLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  mode      String   @default("search")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateClick {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subId     String
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
}

model SearchCache {
  id        String   @id @default(cuid())
  key       String   @unique
  query     String
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Merchant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domain      String?
  active      Boolean  @default(true)
  trustScore  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  feeds       FeedSource[]
  offers      CatalogOffer[]

  @@index([active])
}

model FeedSource {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  slug           String   @unique
  name           String
  url            String
  format         String
  mapping        Json
  authHeaderEnv  String?
  active         Boolean  @default(true)
  lastImportedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  offers         CatalogOffer[]
  runs           ImportRun[]

  @@index([merchantId, active])
}

model CatalogFamily {
  id              String   @id @default(cuid())
  canonicalKey    String   @unique
  title           String
  normalizedTitle String
  brand           String?
  model           String?
  category        String?
  image           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  variants        CatalogVariant[]

  @@index([normalizedTitle])
  @@index([brand, model])
}

model CatalogVariant {
  id           String        @id @default(cuid())
  familyId     String
  family       CatalogFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  variantKey   String
  gtin         String?
  mpn          String?
  color        String?
  storage      String?
  ram          String?
  connectivity String?
  size         String?
  condition    String         @default("New")
  attributes   Json?
  image        String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  offers       CatalogOffer[]

  @@unique([familyId, variantKey])
  @@index([gtin])
  @@index([mpn])
}

model CatalogOffer {
  id              String         @id @default(cuid())
  offerKey        String         @unique
  sourceId        String
  source          FeedSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variantId       String
  variant         CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  externalId      String?
  title           String
  url             String
  image           String?
  price           Float
  oldPrice        Float?
  currency        String         @default("EUR")
  shippingPrice   Float?
  deliveryDaysMin Int?
  deliveryDaysMax Int?
  availability    String?
  stockQty        Int?
  condition       String         @default("New")
  active          Boolean        @default(true)
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  snapshots       CatalogPriceSnapshot[]

  @@index([variantId, active, price])
  @@index([merchantId, active])
  @@index([sourceId, active])
}

model CatalogPriceSnapshot {
  id            String       @id @default(cuid())
  offerId       String
  offer         CatalogOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  price         Float
  shippingPrice Float?
  availability  String?
  stockQty      Int?
  recordedAt    DateTime     @default(now())

  @@index([offerId, recordedAt])
}

model ImportRun {
  id            String     @id @default(cuid())
  sourceId      String
  source        FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status        String     @default("running")
  itemCount     Int        @default(0)
  acceptedCount Int        @default(0)
  rejectedCount Int        @default(0)
  error         String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  @@index([sourceId, startedAt])
}
