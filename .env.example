# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# PostgreSQL (Neon/Vercel Postgres/Supabase etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Optional scheduled catalogue discovery / gap filling.
# Never used by normal interactive search. Tavily coverage is explicitly bounded in code.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional legacy/scheduled discovery compatibility (never used by normal search)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_NAME=Latvia
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEPTH=20

# Optional AI shopping-plan provider; local planner works without it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Affiliate redirect template (optional)
# Supported placeholders: {url} and {subid}
# Example only - use the exact template supplied by your affiliate network.
AFFILIATE_REDIRECT_TEMPLATE=

# Email price alerts (Resend HTTPS API, optional)
RESEND_API_KEY=
ALERT_FROM_EMAIL=Ceniq <alerts@yourdomain.lv>

# Web Push (optional). Generate VAPID keys before enabling push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.lv
